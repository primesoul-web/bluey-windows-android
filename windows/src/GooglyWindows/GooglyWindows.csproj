<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Bluey</AssemblyName>
    <RootNamespace>GooglyWindows</RootNamespace>
    <Version>0.3.8</Version>
    <Product>Bluey for Windows</Product>
    <Description>Bluey host app for Windows — a port of bluey-by-riley (Unlicense).</Description>
    <Copyright>Public domain (Unlicense). Original by rbrown101010.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GooglyProtocol\GooglyProtocol.csproj" />
    <ProjectReference Include="..\GooglyRealtime\GooglyRealtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Makaretu.Dns.Multicast" Version="0.27.0" />
    <PackageReference Include="System.Speech" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Fredoka.ttf" />
  </ItemGroup>

</Project>
